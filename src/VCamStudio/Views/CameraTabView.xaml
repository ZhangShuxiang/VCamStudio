<UserControl x:Class="VCamStudio.Views.CameraTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:VCamStudio.Models"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">

    <Grid Margin="24,18,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Camera power -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="虚拟摄像头" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="CameraToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsCameraOn, Mode=OneWay}"
                                          IsEnabled="{Binding IsNotBusy}"
                                          Click="CameraToggle_Click"
                                          AutomationProperties.Name="虚拟摄像头开关" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding CameraStatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CameraStatus}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding SlotLabel}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="开启后，Windows 相机、浏览器和会议软件会把该通道识别为一个独立摄像头。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18" />

                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,12,0,0"
                                Visibility="{Binding HasCameraError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding CameraError}" Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Media -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="素材" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" Content="选择文件" Command="{Binding ChooseMediaCommand}"
                                    HorizontalAlignment="Right" Padding="10,6" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaGlyph}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaDisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MediaDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource DangerGhostButton}" Content="清除"
                                        Command="{Binding ClearMediaCommand}" Padding="6,4" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding MediaStatus}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="也可以把文件拖到右侧预览" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Parameters -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="画面参数" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                      DisplayMemberPath="Display" IsTextSearchEnabled="False" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧率" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"
                                      DisplayMemberPath="Display" IsTextSearchEnabled="False" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="填充方式" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FitModes}" SelectedItem="{Binding SelectedFitMode, Mode=TwoWay}"
                                      DisplayMemberPath="Display" IsTextSearchEnabled="False" />
                        </Grid>

                        <CheckBox Content="水平镜像画面" IsChecked="{Binding Mirror, Mode=TwoWay}" Margin="74,12,0,0" />

                        <Border Background="#F8FAFC" CornerRadius="9" Padding="10,8" Margin="0,14,0,0">
                            <TextBlock Text="运行中修改分辨率或帧率会自动重启该通道；填充方式与镜像实时生效。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Device info -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设备信息" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="设备名称" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Source ID" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ConfigSourceId}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="输出格式" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="NV12 / RGB32" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: preview -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="{StaticResource PreviewBrush}" CornerRadius="17,17,0,0" ClipToBounds="True"
                            Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Image Source="{Binding PreviewSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="将图片或视频拖到这里" Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="未选择素材时，虚拟摄像头输出动态测试画面" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Background="#CC0B1220" CornerRadius="8" Padding="9,5" Margin="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding CameraStatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CameraStatusShort}" Foreground="#E2E8F0" FontSize="10" FontWeight="Bold" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#CC0B1220" CornerRadius="8" Padding="9,5" Margin="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="{Binding ResolutionText}" Foreground="#CBD5E1" FontSize="10" />
                            </Border>

                            <Border Background="#B30B1220" CornerRadius="8" Padding="9,5" Margin="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FrameRateText}" Foreground="#CBD5E1" FontSize="10" />
                                    <TextBlock Text="  ·  " Foreground="#475569" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedFitMode.Display}" Foreground="#CBD5E1" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Shown when the preview has been closed to save CPU and memory. -->
                    <Border Background="{StaticResource PreviewBrush}" CornerRadius="17,17,0,0" ClipToBounds="True"
                            Visibility="{Binding IsPreviewVisible, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <Border Width="58" Height="58" CornerRadius="18" Background="#172033" HorizontalAlignment="Center">
                                <Viewbox Width="28" Height="28">
                                    <Path Data="M2,12 C5.2,6.8 8.6,5 12,5 C15.4,5 18.8,6.8 22,12 C18.8,17.2 15.4,19 12,19 C8.6,19 5.2,17.2 2,12 Z M12,8.2 A3.8,3.8 0 1 0 12,15.8 A3.8,3.8 0 1 0 12,8.2 Z"
                                          Stroke="#38BDF8" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="预览已关闭" Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="已停止预览画面合成并释放预览位图，降低 CPU 与内存占用。虚拟摄像头仍会正常输出画面。"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="18" Margin="0,8,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="开启预览"
                                    Command="{Binding TogglePreviewCommand}"
                                    AutomationProperties.Name="开启预览"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,9" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="预览即输出" Style="{StaticResource CaptionText}" />
                        <Border Width="4" Height="4" CornerRadius="2" Background="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="BGRA → NV12" Style="{StaticResource CaptionText}" />
                        <Button Style="{StaticResource GhostButton}"
                                Content="关闭预览"
                                Command="{Binding TogglePreviewCommand}"
                                AutomationProperties.Name="关闭预览"
                                Padding="8,4" Margin="12,0,0,0" FontSize="11"
                                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
