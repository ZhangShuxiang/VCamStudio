<Window x:Class="VCamStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VCamStudio.Views"
        Title="VCam Studio"
        Width="1340" Height="860"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,0,20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#0F172A">
                    <Grid>
                        <Ellipse Width="22" Height="22" Stroke="#38BDF8" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Fill="#38BDF8" />
                    </Grid>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VCam Studio" FontSize="20" FontWeight="SemiBold" />
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="7,3" Margin="10,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Windows 11" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Media Foundation 多路虚拟摄像头" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="10,6" Margin="22,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding ComponentBadgeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ComponentBadgeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="加载配置" Command="{Binding LoadConfigCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="保存配置" Command="{Binding SaveConfigCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="安装 / 修复组件" Command="{Binding InstallComponentsCommand}" />
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid Margin="20,0,20,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ListBox ItemsSource="{Binding Tabs}"
                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource TabItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Center">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding CameraStatusBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,8,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}"
                                                Width="24" Height="24"
                                                Content="✕"
                                                FontSize="10"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Visibility="{Binding IsClosable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="关闭标签页" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource IconButton}"
                                Width="34" Height="34"
                                Margin="4,0,0,0"
                                FontSize="20"
                                Content="+"
                                Command="{Binding AddTabCommand}"
                                AutomationProperties.Name="新建虚拟摄像头标签页" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Active tab -->
        <ContentControl Grid.Row="2" Content="{Binding SelectedTab}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:CameraTabView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0F172A">
            <Grid Margin="24,0,18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#38BDF8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" FontSize="11" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConfigPathDisplay}" Foreground="#64748B" FontSize="11"
                               MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource GhostButton}" Foreground="#94A3B8" Content="配置目录" Command="{Binding OpenConfigFolderCommand}" Padding="8,2" Margin="8,0,0,0" />
                    <Button Style="{StaticResource GhostButton}" Foreground="#94A3B8" Content="日志" Command="{Binding OpenLogFolderCommand}" Padding="8,2" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
